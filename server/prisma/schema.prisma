generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
  REFUNDED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String?
  phone        String?
  birthday     DateTime?
  gender       String?
  avatar       String?
  googleId     String?
  role         Role      @default(CUSTOMER)
  cart         Cart?
  orders       Order[]
  reviews      Review[]
  favorites    FavoriteProduct[]
  addresses    Address[]
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model FavoriteProduct {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorite_products")
}

model Address {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String
  province        String
  district        String
  ward            String
  detail          String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String?
  brand            String?
  price            Decimal           @db.Decimal(10, 2)
  imageUrl         String?
  stock            Int               @default(0)
  isActive         Boolean           @default(true)
  isAvailable      Boolean           @default(true)
  isFlashSale      Boolean           @default(false)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  flashSaleItems   FlashSaleItem[]
  favoriteProducts FavoriteProduct[]
  cafeOrderItems   CafeOrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Inventory relations
  recipes          ProductRecipe[]
  branchStocks     BranchInventory[]
  transactionItems InventoryTransactionItem[]
  auditItems       InventoryAuditItem[]

  @@index([categoryId])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  excerpt   String?
  content   String   @db.Text
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blogs")
}

model FlashSaleCampaign {
  id          String   @id @default(uuid())
  name        String
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  items       FlashSaleItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("flash_sale_campaigns")
}

model FlashSaleItem {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           FlashSaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  discountPercentage Int      // 0-100
  stockLimit         Int      @default(0)
  soldCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
  @@map("flash_sale_items")
}

model Banner {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String
  link      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

// --- POS CAFE ENUMS ---

enum CafeTableStatus {
  EMPTY
  SERVING
  WAITING_PAYMENT
}

enum CafeOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CARD
}

// --- POS CAFE MODELS ---

model CafeTable {
  id        String          @id @default(uuid())
  name      String
  status    CafeTableStatus @default(EMPTY)
  isActive  Boolean         @default(true)
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    CafeOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([branchId, name])
  @@map("cafe_tables")
}

model CafeOrder {
  id          String          @id @default(uuid())
  tableId     String
  table       CafeTable       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  status      CafeOrderStatus @default(PENDING)
  totalAmount Decimal         @db.Decimal(10, 2)
  items       CafeOrderItem[]
  payments    Payment[]
  createdById String?
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("cafe_orders")
}

model CafeOrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String    // Lưu tên món tại thời điểm bán
  unitPrice   Decimal   @db.Decimal(10, 2) // Lưu giá tại thời điểm bán
  quantity    Int
  notes       String?   // Ghi chú món (ít đá, nhiều đường,...)
  createdAt   DateTime  @default(now())

  @@map("cafe_order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         CafeOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())

  @@map("payments")
}

model Branch {
  id        String      @id @default(uuid())
  name      String      @unique
  address   String?
  phone     String?
  isActive  Boolean     @default(true)
  tables    CafeTable[]
  orders    CafeOrder[]
  users     User[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Inventory relations
  inventories  BranchInventory[]
  transactions InventoryTransaction[]
  audits       InventoryAudit[]

  @@map("branches")
}

// --- POS INVENTORY ENUMS ---

enum InventoryTransactionType {
  IMPORT         // Nhập kho từ nhà cung cấp
  EXPORT         // Xuất kho (hủy, hỏng, hết hạn...)
  TRANSFER_OUT   // Điều chuyển đi chi nhánh khác
  TRANSFER_IN    // Điều chuyển từ chi nhánh khác đến
  AUDIT_ADJUST   // Điều chỉnh sau kiểm kho
  SALE_DEDUCTION // Tự động khấu trừ khi bán hàng
}

enum AuditStatus {
  PENDING   // Mới tạo phiếu kiểm, chưa cân bằng kho
  ADJUSTED  // Đã đối chiếu và điều chỉnh số dư kho thực tế
}

// --- POS INVENTORY MODELS ---

// 1. Nguyên liệu / Vật tư
model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique                 // Tên nguyên liệu (VD: Cà phê hạt Arabica, Sữa đặc Ngôi sao phương Nam)
  unit        String                           // Đơn vị tính (g, ml, cái, hộp, thùng)
  costPrice   Decimal  @db.Decimal(10, 2)      // Giá vốn trung bình nhập kho
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quan hệ
  recipes          ProductRecipe[]
  branchStocks     BranchInventory[]
  transactionItems InventoryTransactionItem[]
  auditItems       InventoryAuditItem[]

  @@map("ingredients")
}

// 2. Tồn kho chi nhánh (Cả nguyên liệu & Sản phẩm bán lẻ)
model BranchInventory {
  id           String      @id @default(uuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  // Tồn kho có thể gắn với Nguyên liệu HOẶC Sản phẩm bán lẻ trực tiếp
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  quantity     Float       @default(0)         // Số lượng tồn hiện tại (có thể là số thực: 12.5 kg)
  minStock     Float       @default(0)         // Định mức tồn tối thiểu (tồn kho an toàn) để cảnh báo nhập hàng

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([branchId, ingredientId])
  @@unique([branchId, productId])
  @@map("branch_inventories")
}

// 3. Định lượng công thức pha chế
model ProductRecipe {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float      // Số lượng nguyên liệu tiêu hao cho 1 đơn vị sản phẩm (VD: 15g cà phê)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
  @@map("product_recipes")
}

// 4. Nhà cung cấp
model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]

  @@map("suppliers")
}

// 5. Phiếu giao dịch kho (Nhập/Xuất/Điều chuyển/Khấu trừ)
model InventoryTransaction {
  id          String                   @id @default(uuid())
  branchId    String
  branch      Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type        InventoryTransactionType
  
  // Liên kết tùy chọn
  referenceId String?                  // ID hóa đơn bán hàng (nếu trừ bán hàng) hoặc ID phiếu kiểm (nếu là chỉnh kho)
  supplierId  String?
  supplier    Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  notes       String?                  // Ghi chú lý do nhập xuất
  createdById String?                  // Nhân viên tạo phiếu
  createdAt   DateTime                 @default(now())

  items       InventoryTransactionItem[]

  @@map("inventory_transactions")
}

// 6. Chi tiết phiếu giao dịch kho
model InventoryTransactionItem {
  id            String               @id @default(uuid())
  transactionId String
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  ingredientId  String?
  ingredient    Ingredient?          @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  quantity      Float                // Số lượng giao dịch (Dương cho Nhập/Hao hụt bù, Âm cho Xuất/Trừ bán hàng)
  unitPrice     Decimal?             @db.Decimal(10, 2) // Giá nhập/vốn tại thời điểm đó

  @@map("inventory_transaction_items")
}

// 7. Phiếu kiểm kê kho
model InventoryAudit {
  id          String         @id @default(uuid())
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  notes       String?
  status      AuditStatus    @default(PENDING)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       InventoryAuditItem[]

  @@map("inventory_audits")
}

// 8. Chi tiết kiểm kê kho
model InventoryAuditItem {
  id           String         @id @default(uuid())
  auditId      String
  audit        InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  ingredientId String?
  ingredient   Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  systemQty    Float          // Tồn kho trên hệ thống lúc tạo phiếu
  actualQty    Float          // Số lượng thực tế kiểm đếm được
  discrepancy  Float          // Chênh lệch (actualQty - systemQty)

  @@map("inventory_audit_items")
}

